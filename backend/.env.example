CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Optional: CHAT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

IMAGE_PROVIDER=google_auto

# Destination search (Tokyo, Spagna, …). Public Nominatim, no API key.
# NOMINATIM_URL=https://nominatim.openstreetmap.org

# Accounts. Google: create an "iOS" OAuth client (bundle it.robertolibanora.roam) in Google Cloud Console.
GOOGLE_IOS_CLIENT_ID=
# Sign in with Apple needs a paid Apple Developer team (then build with ROAM_APPLE_SIGNIN=1 ios/install.sh).
APPLE_SIGNIN_ENABLED=0
APPLE_BUNDLE_ID=it.robertolibanora.roam
